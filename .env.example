# Resend API Key for sending emails (Server-side only)
RESEND_API_KEY=re_your_api_key_here

# Contact Email address where customer enquiries will be received
CONTACT_TO_EMAIL=hello@weddingflora.com

# Site URL for canonical links and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration (Postgres + Auth for /admin CMS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary Configuration (Photos & 4K Video Reels in /admin Media Library)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
